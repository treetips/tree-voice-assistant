    "s.help.errorSound": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place audio files under .config/tree-voice-assistant/sounds/error to select your own files. Sample sounds are from https://soundeffect-lab.info/."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".config/tree-voice-assistant/sounds/error 配下に音声ファイルを配置すると、自分が用意したファイルを選択することができます。サンプル音声は「効果音ラボ https://soundeffect-lab.info/」を利用しています。"
          }
        }
      }
    },
    "s.help.language": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a file with the same name exists, it will be overwritten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力先に既に同一のファイル名が存在する場合、上書きコピーされます。"
          }
        }
      }
    },
    "s.help.playThis": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays the selected sound."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中のサウンドを再生します。"
          }
        }
      }
    },
    "s.help.showNotification": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows system notifications. OS permission is required separately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OS内蔵の通知を表示します。通知の表示はOS側の権限設定が別途必要になります。"
          }
        }
      }
    },
    "s.help.successSound": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place audio files under .config/tree-voice-assistant/sounds/success to select your own files. Sample sounds are from https://soundeffect-lab.info/."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".config/tree-voice-assistant/sounds/success 配下に音声ファイルを配置すると、自分が用意したファイルを選択することができます。サンプル音声は「効果音ラボ https://soundeffect-lab.info/」を利用しています。"
          }
        }
      }
    },
    "s.help.wallpaper": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place image files under .config/tree-voice-assistant/wallpaper to select your own images."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".config/tree-voice-assistant/wallpaper 配下に背景画像ファイルを配置すると、自分が用意したファイルを選択することができます。"
          }
        }
      }
    },
    "s.help.wallpaperBackgroundColor": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallpaper keeps its aspect ratio, so margins may appear. The background color fills those margins."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景画像は縦横比を維持するため、余白できることがあります。その余白部分の色が背景色になります。"
          }
        }
      }
    },
    "s.help.wallpaperOpacity": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusts the wallpaper opacity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景画像の透明度を調節することができます。"
          }
        }
      }
    },
